    "renderError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card could not be created. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成卡片，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法產生卡片，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードを作成できませんでした。もう一度お試しください。"
