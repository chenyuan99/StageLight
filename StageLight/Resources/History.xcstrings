{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theatre on This Day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧场的今天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劇場的今天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "劇場の今日は何の日"
          }
        }
      }
    },
    "intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small moments. Lasting theatre history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重温舞台历史，分享值得记住的瞬间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重溫舞台歷史，分享值得記住的瞬間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "舞台の歴史を振り返り、記憶に残る瞬間をシェア。"
          }
        }
      }
    },
    "today": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史上的今天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史上的今天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歴史の中の今日"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verified event for today yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天暂无已核实的历史事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天暫無已核實的歷史事件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の日付に該当する確認済みの出来事はまだありません。"
          }
        }
      }
    },
    "browse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览历史"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽歷史"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歴史を見る"
          }
        }
      }
    },
    "starter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small starter collection of Broadway openings. More stories will follow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首批精选百老汇开幕记录，更多舞台故事将陆续加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首批精選百老匯開幕記錄，更多舞台故事將陸續加入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずはブロードウェイ開幕の小さなコレクションから。今後、物語を追加していきます。"
          }
        }
      }
    },
    "source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看来源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看來源"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典を読む"
          }
        }
      }
    },
    "fallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This story is currently available in English."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此条内容暂以英文显示。"
